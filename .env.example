# ============================================================
# JANVAANI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── AI Provider ─────────────────────────────────────────────
# mock  → MockAIService (realistic fake data, no GPU needed)
# yolo  → YOLOAIService (real YOLO26-Seg, requires trained model)
AI_PROVIDER=mock

# ── YOLO Model (only needed when AI_PROVIDER=yolo) ──────────
# YOLO_MODEL_PATH=/app/models/janvaani-yolo26-seg-v1/best.pt

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://janvaani:janvaanipass@db:5432/janvaani
DATABASE_URL_SYNC=postgresql://janvaani:janvaanipass@db:5432/janvaani

# For local development (outside Docker, db host = localhost)
# DATABASE_URL=postgresql+asyncpg://janvaani:janvaanipass@localhost:5432/janvaani

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Security ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Gemini AI ────────────────────────────────────────────────
# Used for AI summaries and "Why is this critical?" explainer
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── File Upload ──────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=/app/uploads

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
